# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > Settings > Secrets. Never commit real keys.
GROQ_API_KEY = "gsk_your_key_here"
# Optional - model ids come from https://console.groq.com/docs/models (or GET https://api.groq.com/openai/v1/models)
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL = "llama-3.3-70b-versatile"
